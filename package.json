{
  "name": "monster-mania",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "22.x",
    "npm": "10.9.8"
  },
  "packageManager": "npm@10.9.8",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "smoke": "node scripts/rules-smoke.mjs",
    "test": "vitest run",
    "test:firestore": "npm --prefix functions run build && firebase emulators:exec --only auth,firestore,functions \"vitest run tests/firestore.rules.test.ts tests/firebase.online.integration.test.ts functions/src/onlineGameRepository.test.ts --no-file-parallelism\"",
    "test:functions": "vitest run src/game/network/authoritativeOnlineGame.test.ts && npm --prefix functions run build",
    "test:watch": "vitest",
    "typecheck": "tsc -b",
    "preview": "vite preview"
  },
  "dependencies": {
    "firebase": "^12.19.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.0",
    "eslint": "^10.9.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "firebase-tools": "15.30.0",
    "globals": "^17.11.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.3.0",
    "vitest": "^4.0.18"
  }
}
